# ============================================================================
# Incidencias - Variables de entorno (.env.example)
# ----------------------------------------------------------------------------
# Copiar a `.env` y completar. NUNCA commitear el `.env` real (está en
# .gitignore). Todas las variables se leen desde `config/settings.py` (vía
# django-environ) o desde `ai/providers.py` (vía os.environ).
#
# > DEMO DEL CURSO: la entrega del TP usa Neon (Postgres en la nube) + Render
# > (deploy) + Supabase (Storage S3 para adjuntos). Si estás armando el entorno
# > para la demo, usá las opciones marcadas [DEMO]. El resto son alternativas.
# ============================================================================


# ----------------------------------------------------------------------------
# Base de datos (REQUERIDA - el sitio no arranca sin esta variable)
# ----------------------------------------------------------------------------
# Solo UNA activa: comentar/descomentar la que corresponda.

# [DEMO] Producción - Base en la nube (Neon). URL con credenciales y sslmode.
# El dashboard de Neon te da la connection string; agregale `?sslmode=require`.
DATABASE_URL=postgresql://neondb_owner:contraseña@ep-xxxx-xxxx.neon.tech/incidencias?sslmode=require
# SI QUIERO CORRER seed_init con reset en NEON desde local, paso TEMPORALMENTE debug a false para que elimine adjuntos de Supabase.
# DJANGO_DEBUG=False 

# [DEV LOCAL] PostgreSQL en la PC (psql local o servicio):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incidencias


# ----------------------------------------------------------------------------
# Django
# ----------------------------------------------------------------------------
# [DEMO] Clave secreta de producción (obligatoria al deployear en Render).
# En dev se usa el default inseguro de settings si no está definida.
DJANGO_SECRET_KEY=cambiame-por-una-clave-secreta-aleatoria-larga

# True en desarrollo / False en producción (Render [DEMO]).
DJANGO_DEBUG=True

# Hosts permitidos. settings.py SIEMPRE agrega .onrender.com, localhost y
# 127.0.0.1 además de este valor. OJO: NO comentar la línea para "restringir" —
# si no existe, el default de settings es ['*'] (acepta cualquier Host).
#
# Opción 1) Dev abierto (acepta cualquier Host, LAN incluida):
# DJANGO_ALLOWED_HOSTS=*
#
# Opción 2) [DEMO] Solo local + produccion (.onrender.com). Otra compu en la
# red recibe 400 DisallowedHost aunque el server escuche en 0.0.0.0. Es la
# opción que usa el deploy de la demo:
DJANGO_ALLOWED_HOSTS=
#
# Opción 3) Lista explícita: restringe SOLO a esos hosts (más los 3 que
# settings agrega siempre). Cualquier otro Host -> 400 DisallowedHost:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50


# ----------------------------------------------------------------------------
# IA - API keys (OPCIONALES: solo se usa la del proveedor activo)
# ----------------------------------------------------------------------------
# settings.py las propaga a os.environ y ai/providers.py las lee según el
# `proveedor` del ModeloIA activo. Si una queda vacía, no se propaga.
#
# [DEMO] La demo activa usa Groq (configurado en seed_init). Las otras keys son
# opcionales si querés probar Gemini/OpenRouter/NVIDIA. Se sacan del dashboard
# de cada proveedor:
#   - Groq:      https://console.groq.com/keys
#   - Google AI: https://aistudio.google.com/apikey
#   - OpenRouter: https://openrouter.ai/settings/keys
#   - NVIDIA:    https://build.nvidia.com (API key del perfil)
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Ollama corre LOCAL y NO usa API key. Solo el host (opcional, default local).
# Se usa únicamente para probar el análisis IA en local (sin nube).
OLLAMA_HOST=http://localhost:11434


# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
# [DEMO] True  -> filtrado/paginación client-side en el navegador (demo, estilo
#                 Angular Material). False -> vuelve al filtrado/paginación
#                 server-side con HTMX (producción). Cambiarlo exige reiniciar
#                 el proceso.
MODO_FILTRO_CLIENTE=True

# [DEMO] True  -> Huey ejecuta las tareas en el mismo request (síncrono; demo,
#                 sin worker). False -> cola real: correr `huey_consumer` como
#                 worker.
AI_IMMEDIATE=True
#
# Referencia: con AI_IMMEDIATE=False hay que levantar el worker aparte.
# PostgresHuey usa la misma DATABASE_URL (no hace falta Redis). Comando:
#   .\venv\Scripts\python.exe manage.py run_huey
# (run_huey es el consumer que instala huey.contrib.djhuey; equivale a
#  huey_consumer ai.tasks.huey desde una shell.)


# ----------------------------------------------------------------------------
# Storage de adjuntos (Supabase Storage [DEMO], compatible S3)
# ----------------------------------------------------------------------------
# Requiere: pip install django-storages[boto3]
# Se usa cuando las credenciales están cargadas Y DJANGO_DEBUG=False (en Render
# [DEMO]); en DEBUG local o sin credenciales usa FileSystemStorage (carpeta
# media/, fallback sin crash).
#
# Las credenciales NO son las API keys de Supabase: son el par de credenciales
# S3 dedicadas que se generan en el dashboard →
#   Storage → <bucket> → configuración S3 (o Settings → Storage → S3).
# Dan acceso total a los buckets: SOLO usarlas del lado servidor.
SUPABASE_ACCESS_KEY=
SUPABASE_SECRET_KEY=
# Region del proyecto (Settings → General → Region, ej. us-east-1).
SUPABASE_REGION=us-east-1
# [DEMO] Nombre exacto del bucket creado para la demo. Acá va el que creaste.
SUPABASE_BUCKET=incidencias_adjuntos
# [DEMO] Hostname DIRECTO de Storage (mejor performance y el que usa la demo):
# https://<ref>.storage.supabase.co/storage/v1/s3
# El <ref> es el ID corto del proyecto (está en la URL del dashboard y además
# en Settings → API → Project URL, sin el /storage/v1/s3).
SUPABASE_ENDPOINT=