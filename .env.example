# ============================================================================
# Incidencias - Variables de entorno (.env.example)
# ----------------------------------------------------------------------------
# Copiar a `.env` y completar. NUNCA commitear el `.env` real (está en
# .gitignore). Todas las variables se leen desde `config/settings.py` (vía
# django-environ) o desde `ai/providers.py` (vía os.environ).
# ============================================================================


# ----------------------------------------------------------------------------
# Base de datos (REQUERIDA - el sitio no arranca sin esta variable)
# ----------------------------------------------------------------------------
# Solo UNA activa: comentar/descomentar la que corresponda.

# Producción (Neon) - URL con credenciales y sslmode:
DATABASE_URL=postgresql://neondb_owner:contraseña@ep-xxxx-xxxx.neon.tech/incidencias?sslmode=require

# Desarrollo local (PostgreSQL en la PC):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incidencias


# ----------------------------------------------------------------------------
# Django
# ----------------------------------------------------------------------------
# Clave secreta de producción (obligatoria en Render). En dev se usa el default
# inseguro de settings si no está definida.
DJANGO_SECRET_KEY=cambiame-por-una-clave-secreta-aleatoria-larga

# True en desarrollo / False en producción (Render).
DJANGO_DEBUG=True

# Hosts permitidos. settings.py SIEMPRE agrega .onrender.com, localhost y
# 127.0.0.1 además de este valor. OJO: NO comentar la línea para "restringir" —
# si no existe, el default de settings es ['*'] (acepta cualquier Host).
#
# Opción 1) Dev abierto (acepta cualquier Host, LAN incluida):
# DJANGO_ALLOWED_HOSTS=*
#
# Opción 2) Solo local + producción (.onrender.com). Otra compu en la red
# recibe 400 DisallowedHost aunque el server escuche en 0.0.0.0:
DJANGO_ALLOWED_HOSTS=
#
# Opción 3) Lista explícita: restringe SOLO a esos hosts (más los 3 que
# settings agrega siempre). Cualquier otro Host -> 400 DisallowedHost:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50


# ----------------------------------------------------------------------------
# IA - API keys (OPCIONALES: solo se usa la del proveedor activo)
# ----------------------------------------------------------------------------
# settings.py las propaga a os.environ y ai/providers.py las lee según el
# `proveedor` del ModeloIA activo. Si una queda vacía, no se propaga.
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Ollama corre local y NO usa API key. Solo el host (opcional, default local).
OLLAMA_HOST=http://localhost:11434


# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
# True  -> filtrado/paginación client-side en el navegador (demo, estilo
#          Angular Material). False -> vuelve al filtrado/paginación server-side
#          con HTMX (producción). Cambiarlo exige reiniciar el proceso.
MODO_FILTRO_CLIENTE=True

# True  -> Huey ejecuta las tareas en el mismo request (síncrono; demo, sin
#          worker). False -> cola real: correr `huey_consumer` como worker.
AI_IMMEDIATE=True
#
# Referencia: con AI_IMMEDIATE=False hay que levantar el worker aparte.
# PostgresHuey usa la misma DATABASE_URL (no hace falta Redis). Comando:
#   .\venv\Scripts\python.exe manage.py run_huey
# (run_huey es el consumer que instala huey.contrib.djhuey; equivale a
#  huey_consumer ai.tasks.huey desde una shell.)


# ----------------------------------------------------------------------------
# PENDIENTE (plan): storage de adjuntos en producción con Supabase
# ----------------------------------------------------------------------------
# Hoy el código NO las lee (STORAGES usa FileSystemStorage en settings.py).
# Quedan acá como referencia del plan para migrar los adjuntos a S3/Supabase
# sin necesidad de tocar el .env de los que ya tienen el proyecto andando.
# SUPABASE_ACCESS_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=
# SUPABASE_ENDPOINT=